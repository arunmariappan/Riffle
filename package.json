{
  "name": "riffle",
  "version": "0.1.0",
  "private": true,
  "description": "A living monsoon mountain stream in the browser: walk, wade, swim, build and watch it evolve.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "vite build && vite preview --port 4173 --strictPort",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chrome --project=edge",
    "bench": "playwright test --project=bench",
    "assets": "tsx tools/assets.ts",
    "bake": "tsx tools/bake.ts",
    "fetch-assets": "tsx tools/fetch-assets.ts"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "comlink": "^4.4.2",
    "mediabunny": "^1.61.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "uplot": "^1.6.32",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^24.19.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "stats-gl": "^4.2.3",
    "tsx": "^4.23.15",
    "tweakpane": "^4.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
